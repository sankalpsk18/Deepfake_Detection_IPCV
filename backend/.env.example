# Deepfake Detector Backend Environment Variables - PRODUCTION
# Copy to .env and modify as needed

# Application
APP_NAME=Deepfake Detector API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# API
API_PREFIX=/api/v1
# Set to your frontend domain(s) in production
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]

# API Key Authentication (optional)
# Comma-separated list of valid API keys. If empty, auth is disabled.
# Example: API_KEYS="key1,key2,key3"
API_KEYS=""

# Model Configuration
# Paths to ONNX model files (place in backend/models/ or set absolute paths)
EFFICIENTNET_MODEL_PATH=efficientnet_b0_deepfake.onnx
MESONET_MODEL_PATH=mesonet_deepfake.onnx
MODEL_OUTPUT_ORDER=fake_first
MODEL_INPUT_SIZE=224
MESONET_INPUT_SIZE=256

# Ensemble weights (must sum to 1.0)
ENSEMBLE_EFFICIENTNET_WEIGHT=0.7
ENSEMBLE_MESONET_WEIGHT=0.3

# Face Detection
FACE_DETECTION_CONFIDENCE=0.5
FACE_CROP_PADDING=0.3

# Inference
INFERENCE_DEVICE=cpu
ONNX_PROVIDERS=["CPUExecutionProvider"]

# Grad-CAM
GRADCAM_ENABLED=true
GRADCAM_TARGET_LAYER=features.7

# Logging
LOG_LEVEL=INFO